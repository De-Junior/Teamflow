# Copy to .env and fill in. Only the "Required" block is needed to run locally;
# every integration below it degrades gracefully when left empty.

# ── Required ────────────────────────────────────────────────────────────────
# Pooled connection used by the app at runtime (Neon, Supabase or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teamflow"
# Direct (non-pooled) connection used by Prisma migrations
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/teamflow"
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Google OAuth (optional) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Transactional email via Resend (optional) ───────────────────────────────
# Without a key, verification / reset / invite links are printed to the dev console.
RESEND_API_KEY=""
EMAIL_FROM="TeamFlow <onboarding@resend.dev>"

# ── Realtime notifications via Pusher (optional) ────────────────────────────
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# ── Billing via Stripe, test mode (optional) ────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PROFESSIONAL=""
STRIPE_PRICE_ENTERPRISE=""

# ── AI insights via Google Gemini (optional) ────────────────────────────────
GEMINI_API_KEY=""


# ── Demo workspace reset (optional) ─────────────────────────────────────────
# Vercel Cron sends this as a Bearer token to /api/cron/reset-demo once a day.
CRON_SECRET=""
